# Secrets for nvmon - supply via your secret manager / CI secrets / systemd EnvironmentFile.
# Never commit a filled-in copy of this file.

# SSH (omit to use keys / ssh-agent). Per-OS variants override the generic one.
NVMON_SSH_PASSWORD=
# NVMON_SSH_PASSWORD_NVOS=
# NVMON_SSH_PASSWORD_CUMULUS=
# NVMON_SSH_PASSWORD_UBUNTU=

# Jira Cloud: account email + API token.  Jira Server/DC: leave USER empty, TOKEN = personal access token.
NVMON_JIRA_USER=
NVMON_JIRA_TOKEN=

# Pushgateway basic auth (optional)
NVMON_PUSHGATEWAY_USER=
NVMON_PUSHGATEWAY_PASSWORD=

# Require "Authorization: Bearer <token>" on the exporter's /metrics (recommended if not bound to localhost)
NVMON_EXPORTER_TOKEN=

# Any non-secret setting can also be overridden here, e.g.
# NVMON_CONFIG=/etc/nvmon/nvmon.toml
# NVMON_JIRA_PROJECT_KEY=NET
# NVMON_PROMETHEUS_LISTEN_PORT=9877
