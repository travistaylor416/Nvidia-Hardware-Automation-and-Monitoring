{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "title": "nvmon - NVIDIA fabric ports & fault isolation",
  "uid": "nvmon-fabric",
  "tags": [
    "nvmon",
    "nvidia",
    "infiniband",
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource"
      },
      {
        "name": "device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Device",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "query": {
          "query": "label_values(nvmon_up, device)",
          "refId": "dev"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "port",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "label": "Port",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "query": {
          "query": "label_values(nvmon_port_oper_up{device=~\"$device\"}, port)",
          "refId": "port"
        },
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Devices reachable",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(nvmon_up{device=~\"$device\"}) / count(nvmon_up{device=~\"$device\"})",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Links at fault",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(nvmon_link_status == 2) or vector(0)",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Links warning",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(nvmon_link_status == 1) or vector(0)",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Failing health checks",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(nvmon_check_status{device=~\"$device\"} == 2) or vector(0)",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Ports down (admin up)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count((nvmon_port_oper_up{device=~\"$device\"} < 1) and on(device,port) (nvmon_port_admin_up == 1)) or vector(0)",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Collection time",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(nvmon_collect_duration_seconds{device=~\"$device\"})",
          "legendFormat": "",
          "format": "time_series",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Fault isolation - where is the link failing?",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_link_fault_info",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "One row per unhealthy link. 'component' is nvmon's verdict: switch_port, switch_transceiver, node_port, node_transceiver, cable, cable_or_far_end, subnet_manager or ambiguous.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "mapped": true
            },
            "renameByName": {
              "Value": "status (1 warn / 2 fault)"
            }
          }
        }
      ]
    },
    {
      "id": 20,
      "title": "Rx errors / s (CRC + symbol + FEC uncorrectable)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(nvmon_port_crc_errors_total{device=~\"$device\",port=~\"$port\"}[5m])",
          "legendFormat": "{{device}} {{port}} crc",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(nvmon_port_symbol_errors_total{device=~\"$device\",port=~\"$port\"}[5m])",
          "legendFormat": "{{device}} {{port}} symbol",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(nvmon_port_fec_uncorrectable_total{device=~\"$device\",port=~\"$port\"}[5m])",
          "legendFormat": "{{device}} {{port}} fec-unc",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "C"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 21,
      "title": "Link flaps (last 1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "increase(nvmon_port_link_downed_total{device=~\"$device\",port=~\"$port\"}[1h]) > 0",
          "legendFormat": "{{device}} {{port}}",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 30,
      "title": "Rx optical power per lane",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_port_rx_power_dbm{device=~\"$device\",port=~\"$port\"}",
          "legendFormat": "{{device}} {{port}} L{{lane}}",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Low Rx with normal far-end Tx = loss in fiber/connectors.",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 31,
      "title": "Tx optical power per lane",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_port_tx_power_dbm{device=~\"$device\",port=~\"$port\"}",
          "legendFormat": "{{device}} {{port}} L{{lane}}",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "description": "Low Tx = that transceiver's laser is failing.",
      "fieldConfig": {
        "defaults": {
          "unit": "dBm"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 32,
      "title": "Transceiver temperature",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_port_module_temperature_celsius{device=~\"$device\",port=~\"$port\"}",
          "legendFormat": "{{device}} {{port}}",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 33,
      "title": "Bit error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_port_effective_ber{device=~\"$device\",port=~\"$port\"}",
          "legendFormat": "{{device}} {{port}} effective",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_port_raw_ber{device=~\"$device\",port=~\"$port\"}",
          "legendFormat": "{{device}} {{port}} raw",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "B"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "custom": {
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 40,
      "title": "Port state",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_port_oper_up{device=~\"$device\",port=~\"$port\"}",
          "legendFormat": "{{device}} {{port}}",
          "format": "time_series",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down"
                },
                "0.5": {
                  "text": "init"
                },
                "1": {
                  "text": "up"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 50,
      "title": "Health checks not passing",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 46,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_check_status{device=~\"$device\"} > 0",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "Value": "status (1 warn / 2 fail)"
            }
          }
        }
      ]
    },
    {
      "id": 51,
      "title": "Transceivers",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nvmon_port_module_info{device=~\"$device\",port=~\"$port\"}",
          "legendFormat": "",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true
            }
          }
        }
      ]
    }
  ]
}
